#!/usr/bin/env bb
(ns proxora.cli
  (:require [babashka.fs :as fs]
            [babashka.process :refer [shell]]))

(defn usage []
  (println "Usage: proxora -lr | -qu | -op FILE.csv | -opqaoa FILE.csv")
  (println "  -lr      Run Clojure linear regression (Babashka)")
  (println "  -qu      Run Python/Qiskit implementation")
  (println "  -op      Max-Cut on an edge-list CSV, classical brute force")
  (println "  -opqaoa  Max-Cut on the same CSV with QAOA in pyQuil (Rigetti QVM)"))

(defn python-route
  "Run a Python engine route. The engine runs from python/, so the CSV path is
  made absolute first to keep paths relative to where the user called proxora."
  [flag path]
  (System/exit (:exit (shell {:continue true, :dir "python"}
                             "uv" "run" "proxora" flag (str (fs/absolutize path))))))

(defn -main [& args]
  (case (first args)
    "-lr" (System/exit (:exit (shell {:continue true}
                                     "bb" "-cp" "clojure/src" "-m" "proxora.regression")))
    "-qu" (do
            (println "Dispatching to Python/Qiskit implementation...")
            (System/exit (:exit (shell {:continue true, :dir "python"}
                                       "uv" "run" "proxora" "-qu"))))
    ("-op" "-opqaoa")
    (if (= 2 (count args))
      (python-route (first args) (second args))
      (do (usage) (System/exit 2)))
    (do
      (usage)
      (System/exit 2))))

(apply -main *command-line-args*)
